		{
			"name": "S3: Rozliczenie semestru (Semester Settlement)",
			"description": "Scenariusz 3: Rozliczenie semestru dla wszystkich aktywnych studentów.\nPromuje na wyższy semestr, jeśli student zdobył co najmniej 21 punktów ECTS z 30 możliwych (czyli suma niezaliczonych ECTS jest <= 9). Semestr 7 nie podlega promocji.",
			"item": [
				{
					"name": "Rozliczenie semestru 2024/2025",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Verify students settlement\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"    ",
									"    // Szukamy poszczególnych studentów w raporcie",
									"    var lewandowski = jsonData.find(s => s.lastName === 'Lewandowski');",
									"    var dabrowska = jsonData.find(s => s.lastName === 'Dabrowska');",
									"    var zielinski = jsonData.find(s => s.lastName === 'Zielinski');",
									"    var kowalski = jsonData.find(s => s.lastName === 'Kowalski');",
									"    ",
									"    if (lewandowski) {",
									"        pm.expect(lewandowski.promoted).to.eql(true);",
									"        pm.expect(lewandowski.failedSubjects).to.be.an('array').that.is.empty;",
									"    }",
									"    ",
									"    if (dabrowska) {",
									"        pm.expect(dabrowska.promoted).to.eql(true); // ECTS niezaliczone = 6, pozostało 24 (warunkowo zdane)",
									"        pm.expect(dabrowska.failedSubjects[0].name).to.eql('Matematyka dyskretna');",
									"    }",
									"    ",
									"    if (zielinski) {",
									"        pm.expect(zielinski.promoted).to.eql(false); // ECTS niezaliczone = 13 (PO: 7 + Matematyka: 6), pozostało 17 (brak promocji)",
									"    }",
									"    ",
									"    if (kowalski) {",
									"        pm.expect(kowalski.promoted).to.eql(false); // Semestr 7 nie podlega promocji automatycznej",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/scenario/semester-settlement?academicYear=2024/2025",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"scenario",
								"semester-settlement"
							],
							"query": [
								{
									"key": "academicYear",
									"value": "2024/2025",
									"description": "Rok akademicki do rozliczenia"
								}
							]
						},
						"description": "Wywołuje rozliczenie semestru dla roku akademickiego 2024/2025.\n* Lewandowski (sem. 3) - pomyślnie zdane przedmioty -> promoted = true\n* Dąbrowska (sem. 3) - 1 przedmiot oblany (6 ECTS), zaliczone 24 ECTS -> promoted = true\n* Zieliński (sem. 3) - 2 przedmioty oblane (13 ECTS), zaliczone 17 ECTS -> promoted = false\n* Kowalski (sem. 7) - zaliczone wszystko, ale semestr 7 -> promoted = false"
					},
					"response": []
				}
			]
		},
