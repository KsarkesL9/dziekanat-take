		{
			"name": "Scenariusz 3 - Semester settlement",
			"description": "Rozliczenie semestru i automatyczna promocja studentów.",
			"item": [
				{
					"name": "Rozliczenie semestru 2024/2025",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Verify students settlement\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"    ",
									"    var lewandowski = jsonData.find(s => s.lastName === 'Lewandowski');",
									"    var dabrowska = jsonData.find(s => s.lastName === 'Dabrowska');",
									"    var zielinski = jsonData.find(s => s.lastName === 'Zielinski');",
									"    var kowalski = jsonData.find(s => s.lastName === 'Kowalski');",
									"    ",
									"    if (lewandowski) {",
									"        pm.expect(lewandowski.promoted).to.eql(true);",
									"        pm.expect(lewandowski.failedSubjects).to.be.an('array').that.is.empty;",
									"    }",
									"    if (dabrowska) {",
									"        pm.expect(dabrowska.promoted).to.eql(true);",
									"        pm.expect(dabrowska.failedSubjects[0].name).to.eql('Matematyka dyskretna');",
									"    }",
									"    if (zielinski) {",
									"        pm.expect(zielinski.promoted).to.eql(false);",
									"    }",
									"    if (kowalski) {",
									"        pm.expect(kowalski.promoted).to.eql(false);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/scenario/semester-settlement?academicYear=2024/2025",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"scenario",
								"semester-settlement"
							],
							"query": [
								{
									"key": "academicYear",
									"value": "2024/2025",
									"description": "Rok akademicki"
								}
							]
						},
						"description": "Wywołanie rozliczenia semestru dla roku akademickiego 2024/2025."
					},
					"response": []
				}
			]
		},
